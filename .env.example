# ==============================================================================
# SIDDHIVINAYAK TOURS & TRAVELS — PRODUCTION BACKEND CONFIGURATION
# ==============================================================================
# Copy this file to '.env' in the project root to configure Email, SMS & MongoDB.
# On Vercel, set these variables in Project Settings > Environment Variables.
#
# IMPORTANT SECURITY:
# 1. These variables are STRICTLY SERVER-SIDE.
# 2. DO NOT prefix with VITE_ to keep API keys secure and hidden from the browser.
# 3. Add .env to your .gitignore (never commit real credentials to git).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MONGODB ATLAS DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Standard MongoDB Atlas connection URI:
# mongodb+srv://<username>:<password>@<cluster-address>/<database-name>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/siddhivinayak?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 2. SERVER-SIDE OTP & JWT SECURITY SECRET
# ------------------------------------------------------------------------------
# Secret key used for cryptographic HMAC verification of OTPs and tokens.
# Generate a 64-character random string for production.
OTP_SECRET=your_secure_random_production_otp_secret_key_here

# ------------------------------------------------------------------------------
# 3. SMTP / NODEMAILER (RECOMMENDED FOR GMAIL & UNIVERSAL EMAIL OTP DELIVERY)
# ------------------------------------------------------------------------------
# For Gmail:
# 1. Enable 2-Step Verification on your Google Account
# 2. Create an App Password at: https://myaccount.google.com/apppasswords
# 3. Paste the 16-character App Password in SMTP_PASS below
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_gmail_app_password
SMTP_FROM="Siddhivinayak Tours" <your_email@gmail.com>

# Or specify a well-known service (e.g. gmail):
# SMTP_SERVICE=gmail

# ------------------------------------------------------------------------------
# 4. EMAIL OTP — RESEND API (OPTIONAL / ALTERNATIVE)
# ------------------------------------------------------------------------------
# If you prefer Resend API (https://resend.com):
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=onboarding@resend.dev

# ------------------------------------------------------------------------------
# 5. SMS OTP — FAST2SMS INDIA (https://www.fast2sms.com)
# ------------------------------------------------------------------------------
FAST2SMS_API_KEY=your_fast2sms_api_key_here
FAST2SMS_SENDER_ID=SDVTUR
